# Which adapter to use: gemini | anthropic | openai
LLM_PROVIDER=gemini

# The model id for that provider. Model names go stale, so this is the only
# place one appears: nothing in the code hardcodes a model.
#   gemini    e.g. gemini-2.5-flash
#   anthropic e.g. claude-sonnet-4-5
#   openai    e.g. gpt-4.1-mini
LLM_MODEL=gemini-2.5-flash

# Only the key matching LLM_PROVIDER needs a value.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point the OpenAI adapter at a compatible endpoint.
# OPENAI_BASE_URL=

# Show the field log (every tool call) to the player. Default true. Set false
# for a run where the player sees only the narration.
SHOW_TOOLS=true

# Optional: server bind address for `python app.py`.
# HOST=127.0.0.1
# PORT=8000
